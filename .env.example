# Copy to .env and fill in. Every value is optional: anything left blank can be
# entered in the app's sidebar instead. Never commit .env.

# AWS credentials. Leave blank to use your AWS profile, SSO session or IAM role
# (boto3's default credential chain).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional, only for temporary (STS) credentials
AWS_SESSION_TOKEN=

# Pre-fills the sidebar form
AWS_REGION=
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=
